// RUN: python %mlirsynth_src_root%/sandbox/sym_solve/main.py %s | FileCheck %s

// CHECK: SUCCESS
func.func @foo(%arg4: f64, %arg5: f64, %arg6: memref<3x3xf64>, %arg7: memref<3x3xf64>, %arg8: memref<3x3xf64>, %arg9: memref<3x3xf64>, %arg10: memref<3x3xf64>) -> memref<3x3xf64> {
  %alloc = memref.alloc() : memref<3x3xf64>
  memref.copy %arg10, %alloc : memref<3x3xf64> to memref<3x3xf64>

  %cst = arith.constant 0.000000e+00 : f64
  affine.for %arg11 = 0 to 3 {
    affine.for %arg12 = 0 to 3 {
      affine.store %cst, %arg6[%arg11, %arg12] : memref<3x3xf64>
      affine.for %arg13 = 0 to 3 {
        %0 = affine.load %arg7[%arg11, %arg13] : memref<3x3xf64>
        %1 = arith.mulf %arg4, %0 : f64
        %2 = affine.load %arg8[%arg13, %arg12] : memref<3x3xf64>
        %3 = arith.mulf %1, %2 : f64
        %4 = affine.load %arg6[%arg11, %arg12] : memref<3x3xf64>
        %5 = arith.addf %4, %3 : f64
        affine.store %5, %arg6[%arg11, %arg12] : memref<3x3xf64>
      }
    }
  }
  affine.for %arg11 = 0 to 3 {
    affine.for %arg12 = 0 to 3 {
      %0 = affine.load %alloc[%arg11, %arg12] : memref<3x3xf64>
      //%1 = arith.mulf %0, %arg5 : f64
      affine.store %0, %alloc[%arg11, %arg12] : memref<3x3xf64>
      affine.for %arg13 = 0 to 3 {
        %2 = affine.load %arg6[%arg11, %arg13] : memref<3x3xf64>
        %3 = affine.load %arg9[%arg13, %arg12] : memref<3x3xf64>
        %4 = arith.mulf %2, %3 : f64
        %5 = affine.load %alloc[%arg11, %arg12] : memref<3x3xf64>
        %6 = arith.addf %5, %4 : f64
        affine.store %6, %alloc[%arg11, %arg12] : memref<3x3xf64>
      }
    }
  }
  return %alloc : memref<3x3xf64>
}